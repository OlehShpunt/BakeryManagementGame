; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bakery Version Control"
run/main_scene="uid://bu0w4uf1r7dc1"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://src/application/event_bus.gd"
StateManager="*res://src/application/state/state_manager.gd"
EventListenerManager="*res://src/presentation/event_listeners/event_listener_manager.gd"
DomainEventBus="*res://src/domain/domain_event_bus.gd"

[display]

window/size/viewport_width=1900
window/size/viewport_height=1100

[editor]

movie_writer/fps=120

[editor_plugins]

enabled=PackedStringArray("res://addons/GDQuest_GDScript_formatter/plugin.cfg", "res://addons/virtual_joystick/plugin.cfg")

[gui]

theme/default_font_multichannel_signed_distance_field=true

